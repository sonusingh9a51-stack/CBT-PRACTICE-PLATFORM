# Copy this file to .env and fill in your project's values
# (Supabase dashboard -> Settings -> API).

# Your project's API URL, e.g. https://cfwvcliqzysonfcuxady.supabase.co
VITE_SUPABASE_URL=https://cfwvcliqzysonfcuxady.supabase.co

# The "publishable" (a.k.a. anon) key — safe to expose in client code,
# this is what it's designed for. Row Level Security is what actually
# protects your data, not keeping this key secret.
# NEVER put a service_role/secret key or database password in this file
# or anywhere in the frontend — that key bypasses Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable__Pb8YQSiMrvcD22lGUcr0w_y2rPJYi6
